PORT=5000
NODE_ENV=development

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Database (MongoDB)
MONGO_URI=mongodb://localhost:27017/smart-tourism

# AI Configuration
# Recommended free option: get a key at https://console.groq.com/keys
#   AI_PROVIDER=groq
#   GROQ_API_KEY=your-key
# Other options: gemini (GEMINI_API_KEY), openrouter (OPENROUTER_API_KEY), openai (OPENAI_API_KEY)
# "mock" needs no key but gives canned demo answers.
AI_PROVIDER=mock
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
AI_MODEL=
OPENAI_BASE_URL=

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173
